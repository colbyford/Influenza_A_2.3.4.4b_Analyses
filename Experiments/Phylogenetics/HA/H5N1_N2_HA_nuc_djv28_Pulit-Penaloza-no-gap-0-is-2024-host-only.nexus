					toggleAllowAutosize on;
					toggleColorsPanel off;
					toggleDiagonal on;
					setDiagonalHeight 80;
					toggleLinkedScrolling on;
					toggleScrollLinkedTables off;
				endTell;
				showWindow;
				getWindow;
				tell It;
					forceAutosize;
				endTell;
